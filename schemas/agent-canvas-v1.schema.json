{
  "$defs": {
    "Assistance": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "prompt": {
          "default": "",
          "title": "Prompt",
          "type": "string"
        }
      },
      "title": "Assistance",
      "type": "object"
    },
    "CanvasField": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "checkbox",
            "select",
            "multiselect"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "placeholder": {
          "default": "",
          "title": "Placeholder",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "importance": {
          "default": "normal",
          "enum": [
            "blocker",
            "high",
            "normal",
            "low"
          ],
          "title": "Importance",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "explicit",
            "inferred",
            "proposed",
            "user-confirmed",
            "unresolved"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "needs-input",
            "conflict"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "title": "Options",
          "type": "array"
        },
        "validation": {
          "$ref": "#/$defs/FieldValidation"
        },
        "assistance": {
          "$ref": "#/$defs/Assistance"
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "provenance",
        "review_status"
      ],
      "title": "CanvasField",
      "type": "object"
    },
    "Completion": {
      "additionalProperties": false,
      "properties": {
        "require_user_approval": {
          "const": true,
          "default": true,
          "title": "Require User Approval",
          "type": "boolean"
        },
        "require_independent_review": {
          "default": false,
          "title": "Require Independent Review",
          "type": "boolean"
        }
      },
      "title": "Completion",
      "type": "object"
    },
    "FieldValidation": {
      "additionalProperties": false,
      "properties": {
        "min_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "pattern": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Server-enforced RE2 full-match pattern; never executed by the browser.",
          "title": "Pattern"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        }
      },
      "title": "FieldValidation",
      "type": "object"
    },
    "InitializationArtifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "primary-prompt",
            "agent-definition",
            "skill",
            "research-request",
            "knowledge-base-plan",
            "project-plan",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "explicit",
            "inferred",
            "proposed",
            "user-confirmed",
            "unresolved"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "needs-input",
            "conflict"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "importance": {
          "default": "normal",
          "enum": [
            "blocker",
            "high",
            "normal",
            "low"
          ],
          "title": "Importance",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "kind",
        "title",
        "content",
        "provenance",
        "review_status"
      ],
      "title": "InitializationArtifact",
      "type": "object"
    },
    "InitializationPlan": {
      "additionalProperties": false,
      "properties": {
        "primary_artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Artifact"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/InitializationArtifact"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "title": "InitializationPlan",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "created_by": {
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        }
      },
      "required": [
        "title",
        "created_by"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "implications": {
          "default": "",
          "title": "Implications",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/CanvasField"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "fields"
      ],
      "title": "Section",
      "type": "object"
    },
    "Tab": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "sections"
      ],
      "title": "Tab",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "agent-canvas/v1",
      "title": "Protocol",
      "type": "string"
    },
    "kind": {
      "const": "formalprompt/specification",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "tabs": {
      "items": {
        "$ref": "#/$defs/Tab"
      },
      "minItems": 1,
      "title": "Tabs",
      "type": "array"
    },
    "completion": {
      "$ref": "#/$defs/Completion"
    },
    "initialization": {
      "$ref": "#/$defs/InitializationPlan"
    }
  },
  "required": [
    "protocol",
    "kind",
    "metadata",
    "tabs"
  ],
  "title": "CanvasDocument",
  "type": "object"
}
