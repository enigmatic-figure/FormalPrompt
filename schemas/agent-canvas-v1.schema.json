{
  "$defs": {
    "AgentWorkflowNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/GraphPosition"
        },
        "input_ports": {
          "items": {
            "$ref": "#/$defs/WorkflowPort"
          },
          "title": "Input Ports",
          "type": "array"
        },
        "output_ports": {
          "items": {
            "$ref": "#/$defs/WorkflowPort"
          },
          "title": "Output Ports",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "explicit",
            "inferred",
            "proposed",
            "user-confirmed",
            "unresolved"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "needs-input",
            "conflict"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "importance": {
          "default": "normal",
          "enum": [
            "blocker",
            "high",
            "normal",
            "low"
          ],
          "title": "Importance",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "kind": {
          "const": "agent",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "prompt_resource": {
          "title": "Prompt Resource",
          "type": "string"
        },
        "agent_definition_resource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Definition Resource"
        },
        "context_resources": {
          "items": {
            "type": "string"
          },
          "title": "Context Resources",
          "type": "array"
        },
        "skill_resources": {
          "items": {
            "type": "string"
          },
          "title": "Skill Resources",
          "type": "array"
        },
        "tool_resources": {
          "items": {
            "type": "string"
          },
          "title": "Tool Resources",
          "type": "array"
        },
        "write_scope": {
          "items": {
            "type": "string"
          },
          "title": "Write Scope",
          "type": "array"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "token_budget": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Budget"
        }
      },
      "required": [
        "id",
        "title",
        "position",
        "provenance",
        "review_status",
        "kind",
        "model",
        "prompt_resource",
        "acceptance_criteria"
